# Adresse de l'API Laravel. OBLIGATOIRE en production (build Vercel) : il n'y a plus de mode démonstration local ;
# sans cette variable, l'application affiche une erreur explicite au lieu de fausses données.
VITE_API_URL=http://localhost:8000/api/v1
# Clé Google Maps Platform — activer « Maps JavaScript API » et « Directions API ».
# Restreindre la clé par référent HTTP (domaine MUTLOG) dans la console Google Cloud.
VITE_GOOGLE_MAPS_API_KEY=
